# =============== Unity Generated Files =============== #
# Unity's main project management files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/Assets/AssetStoreTools/
/Assets/StreamingAssets/

# Autogenerated VS/Rider/MonoDevelop project files
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.meta
.DS_Store

# Cache and logs
/Assets/Plugins/Editor/FMOD/Cache/
.vs/
.idea/
*.log
*.meta

# =============== OSX/Windows Generated Files =============== #
.DS_Store
Thumbs.db

# =============== Backup Files =============== #
# Any files ending with ~ are usually backup files
*~
# Backup created by Unity (for scene/prefab)
*.bak

# =============== Personal Preferences & Settings =============== #
# Local settings that shouldn't be shared
/UserSettings/
/ProjectSettings/ProjectVersion.txt

# =============== Visual Studio / Rider (IDE) Files =============== #
# Ignore all IDE-related temporary files
/[Dd]ebug/
/[Rr]elease/
.user/
.vs/
*.vsp
*.vsn
*.ncb
*.bak
*.vc
*.pdb
*.obj
*.o
*.exe
*.dll
*.so

# Optional: Ignore all video/capture files
# You might want to remove these lines if you need to share large media assets
# *.mp4
# *.mov
